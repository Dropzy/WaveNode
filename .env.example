# Required: use long, unique values. Do not commit the completed .env file.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Required only for an internet-facing first run. It prevents another visitor
# from claiming the administrator account before setup is completed.
SETUP_TOKEN=

# Host folder containing the music collection. It is mounted read-only at /music.
MUSIC_PATH=/absolute/path/to/music

# Browser port for WaveNode.
WAVENODE_PORT=8080
WAVENODE_VERSION=0.1.0

# Public account creation is disabled by default.
ALLOW_REGISTRATION=false

# Usually blank because the included frontend proxy is same-origin.
CORS_ALLOWED_ORIGINS=

# Optional artist image metadata integrations.
FANART_TV_API_KEY=
ARTIST_METADATA_REFRESH_ENABLED=false

# Internet profile settings. Point this DNS name at the server first.
WAVENODE_DOMAIN=music.example.com
ACME_EMAIL=admin@example.com
