# Server Configuration
APP_ENV=development
SERVER_PORT=8080
SERVER_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=music_server
DB_SSLMODE=disable

# Authentication
# Production requires a unique secret of at least 32 characters.
JWT_SECRET=change-this-for-production-with-a-long-random-value
# Defaults to false in production and true in development.
ALLOW_REGISTRATION=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text

# Optional legacy media path. On first startup it is imported into the
# database and can then be managed from Admin Dashboard > Library jobs.
# New installations can leave this empty and add sources through the UI.
MUSIC_PATH=

# Optional writable persistent location for extracted album and artist artwork.
# If unset, WaveNode uses the operating system's user cache directory.
# Docker deployments should set this to a mounted volume such as /data/artwork.
WAVENODE_ARTWORK_PATH=

# DLNA Configuration
DLNA_ENABLED=true
DLNA_PORT=49152
DLNA_SERVER_NAME=Music Server V2
